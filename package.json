{
  "name": "estudo-ia-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "desktop": "env -u SNAP -u SNAP_NAME -u SNAP_REVISION -u SNAP_VERSION -u SNAP_INSTANCE_NAME -u SNAP_USER_DATA -u SNAP_USER_COMMON -u SNAP_DATA -u SNAP_COMMON -u SNAP_CONTEXT -u SNAP_COOKIE -u SNAP_LIBRARY_PATH -u GTK_PATH -u GIO_MODULE_DIR -u LD_LIBRARY_PATH tauri dev",
    "check": "npm run test && cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "check:mvp": "npm run check && npm run build && npm run test:e2e",
    "check:mvp:env": "bash scripts/check-mvp-environment.sh",
    "check:mvp:appimage": "bash scripts/smoke-test-appimage.sh",
    "create:mvp-samples": "bash scripts/create-mvp-samples.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "i18next": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
